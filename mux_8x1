module mux_tb;

  reg [7:0] i;
  reg [2:0] s;
wire y;
integer k;

mux_8_1 dut (
    .i(i),
    .s(s),
    .y(y)
);

initial begin
    $dumpfile("mux.vcd");
  $dumpvars(1, mux_tb);

    i = 8'b10101011;

  for (k = 0; k < 8; k = k + 1) begin
        s = k;
        #10;
        $display("i=%b s=%b y=%b", i, s, y);
    end

    $finish;
