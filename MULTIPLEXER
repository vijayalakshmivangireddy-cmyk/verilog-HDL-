// TESTBENCH OF 2_1 UX
module mux_tb;
  wire y;
  reg i0,i1,s;
  
  mux_2_1 dut(
    .i0(i0),
    .i1(i1),
    .y(y),
    .s(s)
  );
  initial begin
    $monitor("$time |i0=%b|i1=%b|y=%b|s=%b|" ,i0,i1,y,s);
    $dumpvars(1,mux_tb);
    $dumpfile("mux.vcd");
         i0 = 0; i1 = 1; s = 0;
        #10 s = 1;
        #10 i0 = 1; i1 = 0; s = 0;
        #10 s = 1;
    $finish;
  end 
endmodule
//2_1mux design
module mux_2_1(
  input i0,i1,s,
  output y
);
  assign y= s?i1:i0;
endmodule
  
