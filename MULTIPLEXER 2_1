// TESTBENCH OF 2_1 UX
module mux_tb;
  wire y;
  reg i0,i1,s;
  
  mux_2_1 dut(
    .i0(i0),
    .i1(i1),
    .y(y),
    .s(s)
  );
  initial begin
    $monitor("$time |i0=%b|i1=%b|y=%b|s=%b|" ,i0,i1,y,s);
    $dumpvars(1,mux_tb);
    $dumpfile("mux.vcd");
         i0 = 0; i1 = 1; s = 0;
        #10 s = 1;
        #10 i0 = 1; i1 = 0; s = 0;
        #10 s = 1;
    $finish;
  end 
endmodule

//2_1mux design dataflow
module mux_2_1(
  input i0,i1,s,
  output y
);
  assign y= s?i1:i0;
endmodule
  
//2_1mux design structural
module mux_2_1(
  input i0,i1,s,
  output y
);
  wire i,s_bar,w1,w2;
  not g1(s_bar,s);
  and g2(w1,i0,s);
  and g3(w2,i1,s);
  or  g4(y,w1,w2);
endmodule

//2_1mux design behavioural
module mux_2_1(
  input i0,i1,s,
  output reg y
);
  always @(*)begin
    if(s==0)
      y=i0;
    else 
      y=i1;
  end
endmodule
