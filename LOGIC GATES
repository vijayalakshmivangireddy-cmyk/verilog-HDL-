module all_gates (
    input  wire a,      // Input A
    input  wire b,      // Input B
    output wire out_and,  // AND gate output
    output wire out_or,   // OR gate output
    output wire out_xor,  // XOR gate output
    output wire out_nand, // NAND gate output
    output wire out_nor,  // NOR gate output
    output wire out_xnor, // XNOR gate output
    output wire out_not   // NOT gate output (inverts Input A)
);

    assign out_and  = a & b;   // Bitwise AND
    assign out_or   = a | b;   // Bitwise OR
    assign out_xor  = a ^ b;   // Bitwise XOR
    assign out_nand = ~(a & b);// Bitwise NAND
    assign out_nor  = ~(a | b);// Bitwise NOR
    assign out_xnor = ~(a ^ b);// Bitwise XNOR
    assign out_not  = ~a;      // Bitwise NOT (Inverts A)

endmodule



// Structural Implementation using Gate Primitives
module all_gates_structural (
    input  wire a,
    input  wire b,
    output wire out_and,
    output wire out_or,
    output wire out_xor,
    output wire out_nand,
    output wire out_nor,
    output wire out_xnor,
    output wire out_not
);

    // Syntax: gate_type instance_name (output, input1, input2, ...);
    and  g1 (out_and, a, b);
    or   g2 (out_or, a, b);
    xor  g3 (out_xor, a, b);
    nand g4 (out_nand, a, b);
    nor  g5 (out_nor, a, b);
    xnor g6 (out_xnor, a, b);
    not  g7 (out_not, a); // NOT gate takes only one input

endmodule

// Behavioral Implementation using an Always Block
module all_gates_behavioral (
    input  wire a,
    input  wire b,
    output reg  out_and,
    output reg  out_or,
    output reg  out_xor,
    output reg  out_nand,
    output reg  out_nor,
    output reg  out_xnor,
    output reg  out_not
);

    // Triggered whenever input 'a' or 'b' changes value
    always @(a, b) begin
        out_and  = a & b;
        out_or   = a | b;
        out_xor  = a ^ b;
        out_nand = ~(a & b);
        out_nor  = ~(a | b);
        out_xnor = ~(a ^ b);
        out_not  = ~a;
    end

endmodule
